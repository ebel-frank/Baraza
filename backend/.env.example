# Copy to .env and fill in before running docker-compose up.
#
# For local dev via `docker compose up` (spins up a single-node Mongo replica set):
# DATABASE_URL="mongodb://mongo:27017/baraza?replicaSet=rs0"
# For hosting on Render (or anywhere else), use your own MongoDB connection
# string instead (e.g. from Atlas) — it must point at a replica set, which
# Atlas clusters already are:
DATABASE_URL="mongodb://mongo:27017/baraza?replicaSet=rs0"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_GENERATION_MODEL="gemini-2.5-flash"
PORT=3000

# Signs mediator login/session tokens. Required — the backend refuses to start
# without it. Set a long random value.
JWT_SECRET="change-me-to-a-long-random-string"

# Seeded demo account (see README "Demo script") and the overseeing-institution
# admin account. Required by `npm run seed`. Pick your own values; these are
# only placeholders.
DEMO_PASSWORD="change-me"
ADMIN_PASSWORD="change-me"
